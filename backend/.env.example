# ==============================================================================
# Pausas Activas Inteligentes — Plantilla de Variables de Entorno (Backend)
# En producción (Render), configura estas variables en Environment Variables
# (o mediante render.yaml) sin subir ningún archivo .env al repositorio.
# ==============================================================================

APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Monterrey

# URL pública del Frontend en Vercel (se usa en CORS y enlaces de correo)
FRONTEND_URL=https://tu-proyecto.vercel.app
# Alias retrocompatible (si se omite, se toma FRONTEND_URL)
APP_URL=https://tu-proyecto.vercel.app

# Lista adicional de orígenes permitidos por CORS separados por coma (FRONTEND_URL se agrega automáticamente)
CORS_ALLOWED_ORIGINS=https://tu-proyecto.vercel.app

# ------------------------------------------------------------------------------
# Autenticación Stateless JWT Bearer (HMAC-SHA256) + Cifrado de Secretos
# Genera secretos aleatorios de 64 caracteres hexadecimales (ej. openssl rand -hex 32)
# ------------------------------------------------------------------------------
JWT_SECRET=
JWT_TTL_SECONDS=604800
APP_KEY=
MASTER_ENCRYPTION_KEY=

# Respaldo de sesión PHP (usado solo como fallback secundario en desarrollo local)
SESSION_LIFETIME=604800
SESSION_SAMESITE=None

# ------------------------------------------------------------------------------
# Base de Datos: Azure SQL Database (T-SQL via pdo_sqlsrv)
# Para desarrollo local en XAMPP usa DB_DRIVER=mysql, DB_HOST=127.0.0.1, DB_PORT=3306
# ------------------------------------------------------------------------------
DB_DRIVER=sqlsrv
DB_HOST=tu-servidor.database.windows.net
DB_PORT=1433
DB_NAME=pausas_activas_db
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# Integraciones de Terceros (Google OAuth + Google Gemini AI)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ------------------------------------------------------------------------------
# Seguridad, Expiración de Tokens y Rate Limiting
# ------------------------------------------------------------------------------
EMAIL_VERIFY_EXPIRY_MINUTES=10080
MAGIC_LINK_EXPIRY_MINUTES=15
PASSWORD_RESET_EXPIRY_MINUTES=30
RATE_LIMIT_AUTH_PER_MIN=12
RATE_LIMIT_CHATBOT_PER_MIN=10

# ------------------------------------------------------------------------------
# OpenStreetMap Overpass / Nominatim (caché efímero en backend/storage/cache)
# ------------------------------------------------------------------------------
OSM_CACHE_TTL_SECONDS=300
OSM_USER_AGENT=PausasActivasInteligentes/3.1 (https://tu-proyecto.vercel.app; soporte@pausasactivas.edu.mx)

# ------------------------------------------------------------------------------
# Correo Transaccional SMTP (PHPMailer: verificación, magic link, recuperación)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Pausas Activas Inteligentes
